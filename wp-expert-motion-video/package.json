{
  "name": "wp-expert-motion-video",
  "version": "1.0.0",
  "description": "WP Expert Solution — Facebook Page to Website. Bengali 9:16 motion-design reel built with Remotion + React.",
  "private": true,
  "scripts": {
    "setup": "node scripts/generate-sfx.js && node scripts/build-captions.mjs",
    "prestart": "node scripts/generate-sfx.js",
    "prerender": "node scripts/generate-sfx.js",
    "start": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts WPExpertReel out/wp-expert-reel.mp4",
    "build-captions": "node scripts/build-captions.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/hind-siliguri": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@remotion/cli": "4.0.538",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.7.2"
  }
}
